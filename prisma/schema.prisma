generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  // Phone number is the login identifier - auth is mobile OTP based.
  // Stored in E.164 format (e.g. +919876543210).
  phoneNumber String   @unique
  email       String?  @unique
  name        String?

  // Saved profile / default delivery details
  address     String?
  city        String?
  state       String?
  pincode     String?

  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  orders      Order[]
  reviews     Review[]
  wishlists   Wishlist[]
  leads       Lead[]
  auditActed  AuditLog[] @relation("AuditActor")
  auditTarget AuditLog[] @relation("AuditTarget")

  @@index([createdAt])
}

/// Short-lived mobile OTP challenges. `code` stores an HMAC of the OTP, never
/// the plaintext, so a database leak alone cannot be used to sign in.
model Otp {
  id          String   @id @default(cuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([expiresAt])
}

/// Audit trail of OTP activity. Written for both providers, so delivery and
/// verification can be traced even when MiniMoth owns the code itself.
model OtpLog {
  id          String   @id @default(cuid())
  phoneNumber String
  status      String   // SENT | VERIFIED | FAILED
  provider    String   // minimoth | self-hosted
  detail      String?
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([createdAt])
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Collection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products     Product[]
  productDemos ProductDemo[]

  @@index([isActive])
}

model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String
  shortDesc   String?

  price        Float
  comparePrice Float?

  featured  Boolean @default(false)
  isActive  Boolean @default(true)

  hairColor   String?
  hairLength  String?
  hairStyle   String?
  hairTexture String?

  /// Free-form supplier specification table (e.g. Gender, Weight, Material,
  /// Country of Origin) stored as { "Attribute": "Value" } pairs.
  specs Json?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  collectionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collection    Collection       @relation(fields: [collectionId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems Wishlist[]
  leads         Lead[]

  @@index([collectionId])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  publicId  String?
  alt       String?
  sortOrder Int     @default(0)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  color        String?
  length       String?
  texture      String?
  sku          String? @unique
  stock        Int     @default(0)
  price        Float?
  comparePrice Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([productId])
  @@index([stock])
}

/// Short clips shown in the "Product Demo" carousel on the homepage, each tied
/// to the collection it showcases. Media lives on Cloudinary; only URLs here.
model ProductDemo {
  id           String  @id @default(cuid())
  title        String
  videoUrl     String
  posterUrl    String?
  collectionId String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([isActive])
  @@index([sortOrder])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @default(dbgenerated("gen_random_uuid()::text"))
  userId      String?
  status      OrderStatus @default(PENDING)
  subtotal    Float       @default(0)
  shipping    Float       @default(0)
  discount    Float       @default(0)
  couponCode  String?
  total       Float       @default(0)
  notes       String?
  whatsappSentAt DateTime?

  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?

  shippingName    String  @default("")
  shippingPhone   String  @default("")
  shippingEmail   String?
  shippingLine1   String  @default("")
  shippingLine2   String?
  shippingCity    String  @default("")
  shippingState   String  @default("")
  shippingPincode String  @default("")
  shippingCountry String  @default("India")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  whatsappMessages WhatsAppMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  // Nullable so the catalogue can be replaced without destroying order history.
  // The snapshot columns below keep the line item fully readable on their own.
  variantId       String?
  quantity        Int
  price           Float
  productTitle    String  @default("")
  variantLabel    String?
  productImageUrl String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

enum OrderStatus {
  PENDING
  WHATSAPP_SENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─── Payments ────────────────────────────────────────────────────────────────
// No payment gateway — payment is coordinated entirely over WhatsApp and
// confirmed manually by an admin, so Order.paymentStatus/paidAt (below) is
// the only state that's needed; there's no external payment entity to track.

enum PaymentStatus {
  UNPAID
  PAYMENT_PENDING
  PAID
  FAILED
  REFUNDED
}

model WhatsAppMessage {
  id                String   @id @default(cuid())
  orderId           String?
  phone             String
  messageType       String
  status            String
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([phone])
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String
  approved  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([approved])
  @@index([userId])
  @@index([createdAt])
}

// ─── Wishlist ─────────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ─── Lead CRM ─────────────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String
  subject   String?
  message   String
  source    LeadSource @default(CONTACT_FORM)
  status    LeadStatus @default(NEW)
  notes     String?
  userId    String?
  productId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([source])
  @@index([email])
  @@index([createdAt])
}

enum LeadSource {
  CONTACT_FORM
  CONSULTATION_FORM
  PRODUCT_INQUIRY
  WHATSAPP_INQUIRY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryLog {
  id        String          @id @default(cuid())
  variantId String
  change    Int
  reason    InventoryReason
  note      String?
  adminId   String?
  createdAt DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
}

enum InventoryReason {
  STOCK_ADDED
  STOCK_REMOVED
  STOCK_ADJUSTED
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN
}

// ─── Content ─────────────────────────────────────────────────────────────────



// ─── Promotions ──────────────────────────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String
  discountValue  Float
  minOrderAmount Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  entityType   String?
  entityId     String?
  ipAddress    String?
  userAgent    String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id])
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
